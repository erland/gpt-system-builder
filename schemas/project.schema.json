{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/system-builder/project.schema.json",
  "title": "System Builder Project State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source",
    "complexity",
    "delivery"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "zip",
            "github"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "complexity": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "stack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "frontend": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packaging"
      ],
      "properties": {
        "packaging": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
