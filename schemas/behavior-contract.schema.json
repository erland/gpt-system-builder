{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform-neutral Behavior Contract",
  "type": "object",
  "required": ["contract_version", "canonical_instruction", "critical_behavior_location", "required_markers"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "canonical_instruction": {"type": "string", "minLength": 1},
    "critical_behavior_location": {"const": "canonical_instruction"},
    "knowledge_may_not_be_required_for_core_behavior": {"type": "boolean"},
    "required_markers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
